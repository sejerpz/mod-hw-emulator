From: Andrea Del Signore <sejerpz@gmail.com>
Subject: [PATCH] Hardware addressing on MOD Desktop when the descriptor has actuators

MOD Desktop locks the Device addressing tab and shows a card for the hardware in its place. With a
controller attached (mod-hw-emulator lays a descriptor with actuators over MOD Desktop) the tab is
unlocked and the snapshot "assign all" button stays. Control Chain stays locked.
---
--- a/html/js/hardware.js
+++ b/html/js/hardware.js
@@ -801,7 +801,10 @@
             // Device and Control Chain need MOD hardware. Under MOD Desktop the
             // tab stays, marked locked: selecting it shows the hardware card
             // instead of addressing options (see the click handler below).
-            if (options.isApp() && (jbtn.attr('data-value') === deviceOption || jbtn.attr('data-value') === ccOption)) {
+            // A hardware descriptor with actuators (a controller attached, as
+            // with mod-hw-emulator) unlocks the Device tab.
+            if (options.isApp() && ((jbtn.attr('data-value') === deviceOption && !DesktopApp.hasActuators()) ||
+                                    jbtn.attr('data-value') === ccOption)) {
               jbtn.addClass('desktop-app-locked')
             }
             // Hide MIDI tab if not available
--- a/html/js/desktop-app.js
+++ b/html/js/desktop-app.js
@@ -229,7 +229,17 @@
 
     setupAddressing: function () {
         // The snapshot "assign all" button drives hardware addressing.
-        $('#pedal-presets-window').find('.js-assign-all').hide()
+        if (! DesktopApp.hasActuators()) {
+            $('#pedal-presets-window').find('.js-assign-all').hide()
+        }
+    },
+
+    /* The hardware descriptor of MOD Desktop has no actuators. One that has them
+     * comes with a controller attached (mod-hw-emulator): hardware addressing is
+     * there to use, not to advertise. */
+    hasActuators: function () {
+        return typeof HARDWARE_PROFILE !== 'undefined' && !!HARDWARE_PROFILE &&
+               Object.keys(HARDWARE_PROFILE).length > 0
     },
 
     /* Hardware-only addressing targets stay selectable in the dialog. Picking one
